# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── BitNot: never publish secrets, local data, or media ──────────────

# Environment files and local secrets
.env
.env.*
!.env.example
*.secret
*.secrets

# Signing certificates and private keys (code signing, Tauri updater keys)
*.pfx
*.p12
*.pem
*.key
*.snk
*.cer
*.crt

# Local databases, including SQLite side files and recovery copies
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.repair
*.damaged-*
session.lock

# Crash dumps and temporary files
*.dmp
*.tmp
*.access-probe

# Audio and personal media: music never belongs in this repository
*.mp3
*.flac
*.wav
*.m4a
*.aac
*.ogg
*.oga
*.opus
*.wma
*.aif
*.aiff
*.ape
*.dsf
*.dff
*.wv
*.mka

# Build caches and tool output
coverage/
.vite/
*.tsbuildinfo

# Windows shell files
Thumbs.db
desktop.ini
